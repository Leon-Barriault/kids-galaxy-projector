# Line endings are pinned here rather than left to each machine's
# core.autocrlf. Text is stored LF in the repo and checked out LF everywhere,
# Windows included: pi-server ships to a Linux Pi, and a shell script or
# Dockerfile that arrives with CRLF fails as "bad interpreter: /bin/bash^M".
* text=auto eol=lf

# The files where a wrong ending is an outage, stated explicitly so a future
# blanket edit above cannot quietly take them with it.
*.sh         text eol=lf
gradlew      text eol=lf
Makefile     text eol=lf
Dockerfile   text eol=lf
*.Dockerfile text eol=lf

# Windows-native scripts. .bat/.cmd are frozen as committed (-text) because
# android/gradlew.bat is vendored by the Gradle wrapper and is correctly CRLF
# already; converting it would rewrite a file we do not own.
*.bat -text
*.cmd -text
*.ps1 text eol=crlf

# Binaries: never convert.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.jar  binary
*.jks      binary
*.keystore binary
*.p12  binary
*.pfx  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
