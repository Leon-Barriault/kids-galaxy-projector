# Android
*.iml
.gradle/
/.idea/
# NOTE: android/local.properties is intentionally NOT ignored. It carries the
# local-debug server settings and is committed so a fresh clone runs without
# configuration. It deliberately contains no sdk.dir - that is the one
# genuinely machine-specific line, and Studio or ANDROID_HOME supplies it.
# NOTE: android/.idea/ is not covered by the /.idea/ rule above, which is
# anchored to the repository root. Its shared run configurations are committed;
# an allowlist in android/.idea/.gitignore keeps the machine-specific rest out.
.DS_Store
build/
/captures
.externalNativeBuild
.cxx
*.apk
*.ap_
*.aab
# NOTE: android/gradle/wrapper/gradle-wrapper.jar is intentionally committed -
# the wrapper is how CI and new contributors get a reproducible Gradle version.

# Certificates and keys - generated per deployment, never committed
pi-server/certs/*.crt
pi-server/certs/*.key
pi-server/certs/*.p12
pi-server/certs/*.srl
pi-server/certs/*.csr
android/app/src/main/assets/*.p12
android/app/src/main/assets/*.crt
android/manager/src/main/assets/*.p12
android/manager/src/main/assets/*.crt

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.env
*.egg-info/
dist/
build/

# Runtime data
pi-server/uploads/*
!pi-server/uploads/.gitkeep
pi-server/state/*
!pi-server/state/.gitkeep

# IDE
.vscode/
*.swp
*.swo

# Coverage artifacts
.coverage
.coverage.*
coverage*.xml
htmlcov/
.ruff_cache/
.pytest_cache/

# Hero-frame captures from scripts/capture_planet_look.py. Regenerable, and
# rewritten on every run.
artifacts/look/
