# Android
*.iml
.gradle/
local.properties
/.idea/
.DS_Store
build/
/captures
.externalNativeBuild
.cxx
*.apk
*.ap_
*.aab
# NOTE: android/gradle/wrapper/gradle-wrapper.jar is intentionally committed -
# the wrapper is how CI and new contributors get a reproducible Gradle version.

# Certificates and keys - generated per deployment, never committed
pi-server/certs/*.crt
pi-server/certs/*.key
pi-server/certs/*.p12
pi-server/certs/*.srl
pi-server/certs/*.csr
android/app/src/main/assets/*.p12
android/app/src/main/assets/*.crt

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.env
*.egg-info/
dist/
build/

# Uploads (runtime)
pi-server/uploads/*
!pi-server/uploads/.gitkeep

# IDE
.vscode/
*.swp
*.swo

# Coverage artifacts
.coverage
.coverage.*
coverage*.xml
htmlcov/
.ruff_cache/
.pytest_cache/
