<?xml version="1.0" encoding="utf-8"?>
<!--
  Release policy: HTTPS only.

  The field build authenticates with mTLS and pins trust to the project CA
  programmatically, in ApiClient - it installs its own SSLSocketFactory and
  TrustManager, so the anchors below apply to nothing else the app does. There
  is deliberately no cleartext exemption here: a misconfigured host must fail
  loudly rather than quietly downgrade to plaintext.

  The debug variant overrides this whole file from src/debug/res/xml. That
  split exists because manifestPlaceholders do NOT reach resource XML - the
  manifest merger rewrites AndroidManifest.xml and nothing else, so a
  "${serverHost}" written in here stays literal text and silently matches no
  host at all. Source-set overrides are the mechanism that actually works.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
