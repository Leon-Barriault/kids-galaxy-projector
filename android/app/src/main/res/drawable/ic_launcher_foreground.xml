<!--
  Launcher icon foreground: the kid's planet with a ring, matching the
  projector's favicon. Drawn as a vector so the project needs no binary assets.

  108x108 with the artwork kept inside the central 72x72 safe zone, as adaptive
  icons may be masked to any shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Planet -->
    <path
        android:fillColor="#4FC3F7"
        android:pathData="M54,32 A22,22 0 1,1 53.9,32 Z" />

    <!-- Ring, tilted -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-20">
        <path
            android:pathData="M28,54 A26,9 0 1,1 80,54 A26,9 0 1,1 28,54 Z"
            android:strokeColor="#FFD54F"
            android:strokeWidth="4" />
    </group>
</vector>
