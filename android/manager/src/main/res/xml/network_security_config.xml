<?xml version="1.0" encoding="utf-8"?>
<!--
  Release policy: HTTPS only.

  The manager release build presents manager.p12 through MutualTls and pins
  trust to the project CA programmatically. There is deliberately no cleartext
  exemption here: a misconfigured manager endpoint must fail loudly instead of
  silently downgrading a destructive administration surface to plaintext.

  The debug variant overrides this file from src/debug/res/xml and permits
  cleartext for local bench work.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
